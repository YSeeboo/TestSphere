{
  "name": "atp-frontend",
  "version": "0.1.0",
  "description": "Automated Test Platform Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
